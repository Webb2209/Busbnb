# ─── BusBnB Docker Compose Environment ───────────────────────────────────────
# Copy this file to .env (same directory) and fill in all values before running
# docker compose up. NEVER commit the filled-in .env to git.
#
# Usage:
#   cp .env.compose .env   # then fill in values below
#   docker compose up -d

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=busbnb_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=busbnb_db

# ── JWT (generate with: openssl rand -hex 64) ─────────────────────────────────
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_64

# ── M-Pesa Daraja ─────────────────────────────────────────────────────────────
# Get these from: https://developer.safaricom.co.ke → Your App
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_SHORTCODE=174379
MPESA_PASSKEY=CHANGE_ME
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_CALLBACK_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at: https://resend.com
RESEND_API_KEY=CHANGE_ME
